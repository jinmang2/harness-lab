# Copy to .env and fill in. `lab` loads this file on startup; real environment variables win.

# Model (shared by the lab engine and DeepSeek Harness so only the harness differs).
DEEPSEEK_API_KEY=
LAB_MODEL=deepseek-v4-flash
# enabled | disabled  (DeepSeek thinking mode; DSH defaults to enabled)
LAB_THINKING=enabled
# low | high | max
LAB_REASONING_EFFORT=high

# Optional: any other provider for the lab engine, e.g. "openai:gpt-5.4" (init_chat_model spec).
# LAB_MODEL_SPEC=

# Optional: route both engines through the local gateway to record exact wire requests.
# `lab gateway --mode proxy` then set:
# DEEPSEEK_BASE_URL=http://127.0.0.1:8790

# Optional tracing backends for the lab engine.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3000
